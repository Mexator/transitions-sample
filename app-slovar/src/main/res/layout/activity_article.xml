<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Shared element source arrives here from another process (Пример 6).
             transitionName is set in code (SlovarContract.TRANSITION_WORD). -->
        <TextView
            android:id="@+id/article_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="48sp"
            android:textStyle="bold" />

        <!-- The same row of cells the game field is built from (core-dict):
         одно приложение показывает слово «клетками» другого. -->
        <dev.anton.core.dict.widget.BoardRowView
            android:id="@+id/article_word_row"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:boardColumns="5"
            app:boardCellSize="40dp"
            app:boardCellMargin="4dp"
            app:boardCellTextSize="20sp" />

        <TextView
            android:id="@+id/article_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/close" />
    </LinearLayout>
</ScrollView>
