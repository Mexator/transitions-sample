<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Заголовок статьи — слово «клетками»: тот же ряд, из которого собрано
         поле игры (общий виджет core-dict). Сюда же прилетает shared element из
         другого процесса (Пример 6); transitionName ставится в коде. -->
        <ru.mexator.core.dict.widget.BoardRowView
            android:id="@+id/article_word_row"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:boardColumns="5"
            app:boardCellSize="52dp"
            app:boardCellMargin="4dp"
            app:boardCellTextSize="24sp" />

        <TextView
            android:id="@+id/article_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/close" />
    </LinearLayout>
</ScrollView>
