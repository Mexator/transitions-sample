    <attr format="dimension" name="boardCellSize"/>
    <attr format="dimension" name="boardCellTextSize"/>
    <attr format="integer" name="boardColumns"/>
    <attr format="integer" name="boardRows"/>
    <color name="board_cell_default">#FFF2F2F2</color>
    <color name="board_frame">#FFE8E8E8</color>
    <color name="keyboard_key">#FFDFE1E4</color>
    <color name="keyboard_key_action">#FFC5CEDA</color>
    <color name="mark_absent">#FF9A9A9A</color>
    <color name="mark_correct">#FF6AAA64</color>
    <color name="mark_present">#FFC9B458</color>
    <declare-styleable name="BoardRowView">
        <attr name="boardColumns"/>
        <attr name="boardCellSize"/>
        <attr name="boardCellMargin"/>
        <attr name="boardCellTextSize"/>
        <attr name="boardCellColor"/>
    </declare-styleable>
    <declare-styleable name="BoardView">
        <attr name="boardRows"/>
