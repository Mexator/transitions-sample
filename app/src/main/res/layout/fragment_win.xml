<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:elevation="4dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Пример 5: экран победы как отдельный фрагмент. Ряд-заголовок — сам
         shared element: сюда прилетает выигравший ряд поля (transitionName
         ставится в коде), отсюда он летит дальше — в шапку статьи и, на Примере
         6, в «Словарь». Геометрия та же, что у word_chip и заголовка «Словаря»:
         ряд-в-ряд одинаковой клетки. -->
    <TextView
        android:id="@+id/win_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ru.mexator.core.ui.widget.BoardRowView
        android:id="@+id/win_word_row"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boardColumns="5"
        app:boardCellSize="52dp"
        app:boardCellMargin="4dp"
        app:boardCellTextSize="24sp" />

    <Button
        android:id="@+id/btn_win_meaning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/meaning" />

    <Button
        android:id="@+id/btn_win_slovar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/open_in_slovar" />

    <Button
        android:id="@+id/btn_win_restart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/restart" />
</LinearLayout>
