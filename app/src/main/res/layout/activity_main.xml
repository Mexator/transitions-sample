<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Пример 5: единственный фрагмент-контейнер. GameFragment (сцены + финал
         слоя FRAGMENT OFF) живёт в нём всегда; WinFragment и ArticleFragment
         добавляются поверх — shared element летит между фрагментами одного
         контейнера. -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
