<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/game_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textSize="14sp" />

    <!-- Shared element with the mini field in scene_start (transitionName="board").
         The FRAME is the shared element; CenteredChangeBounds replays the mini
         field's bounds onto it with scale + translation around the center, so the
         cells inside scale along with the frame instead of being clipped.
         Rows are BoardRowView instances — exactly what the restart Explode targets. -->
    <ru.mexator.core.ui.widget.BoardView
        android:id="@+id/board"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/board_frame"
        android:padding="4dp"
        android:transitionName="board"
        app:boardRows="6"
        app:boardColumns="5"
        app:boardCellSize="52dp"
        app:boardCellMargin="3dp"
        app:boardCellTextSize="22sp" />

    <!-- Пример 4: сворачиваемая подсказка — тап по «строке-ссылке» раскрывает
         hintText ниже. Частые тапы по ней и есть сюжет отмены анимаций. -->
    <TextView
        android:id="@+id/hint_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/show_hint"
        android:textColor="?attr/colorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- M2 (Пример 4): becomes the expandable hint card -->
    <TextView
        android:id="@+id/hint_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textSize="14sp"
        android:visibility="gone" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Shared element №2: matches the start scene's keyboard by transitionName -->
    <ru.mexator.core.ui.widget.KeyboardView
        android:id="@+id/keyboard"
        style="@style/Widget.Slovo.KeyboardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:transitionName="keyboard" />
</LinearLayout>
