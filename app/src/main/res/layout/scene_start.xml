<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- The content block floats in the middle. The keyboard is pinned to the
         bottom at the SAME bounds as in scene_game (same padding, same bottom
         margin), so the scene swap leaves it standing — already docked. -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/app_name"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:text="@string/subtitle"
        android:textSize="16sp" />

    <!-- Shared element №1: a small copy of the field. transitionName="board"
         matches the full board in scene_game; CenteredChangeBounds grows the
         final board out of these bounds around their center (Пример 2). -->
    <LinearLayout
        android:id="@+id/board_preview"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:background="#E8E8E8"
        android:orientation="vertical"
        android:padding="4dp"
        android:transitionName="board" />

    <Button
        android:id="@+id/play_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:text="@string/play"
        android:textSize="18sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Shared element №2: the keyboard exists in BOTH scenes at identical
         bounds with the same transitionName. Keys are built here too, but
         inert until the game starts. -->
    <LinearLayout
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:transitionName="keyboard" />
</LinearLayout>
