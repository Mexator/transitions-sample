<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- The content block floats in the middle. The keyboard is pinned to the
         bottom at the SAME bounds as in scene_game (same padding, same bottom
         margin), so the scene swap leaves it standing — already docked. -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- title/subtitle get ids: Пример 3 targets them (by instance) so only these
         fade out on the scene swap, while the matched board/keyboard stay solid. -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/app_name"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:text="@string/subtitle"
        android:textSize="16sp" />

    <!-- Shared element №1: a small copy of the field — the same BoardView with
         smaller cells. transitionName="board" matches the full board in
         scene_game; CenteredChangeBounds grows the final board out of these
         bounds around their center (Пример 2). -->
    <ru.mexator.core.ui.widget.BoardView
        android:id="@+id/board_preview"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@color/board_frame"
        android:padding="4dp"
        android:transitionName="board"
        app:boardRows="6"
        app:boardColumns="5"
        app:boardCellSize="22dp"
        app:boardCellMargin="2dp"
        app:boardCellTextSize="10sp" />

    <Button
        android:id="@+id/play_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:text="@string/play"
        android:textSize="18sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Shared element №2: the keyboard exists in BOTH scenes at identical
         bounds with the same transitionName. KeyboardView builds its keys
         itself; without a listener they are inert until the game starts. -->
    <ru.mexator.core.ui.widget.KeyboardView
        android:id="@+id/keyboard"
        style="@style/Widget.Slovo.KeyboardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:transitionName="keyboard" />
</LinearLayout>
